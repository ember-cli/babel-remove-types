{
  "compilerOptions": {
    "target": "es2020",
    "module": "node20",
    "removeComments": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,

    "moduleResolution": "node16",
    "baseUrl": ".",

    "sourceRoot": "./src",
    "sourceMap": true,

    "declaration": true,
    "declarationMap": true,
    "outDir": "dist"
  },
  "include": [
    "src",
  ]
}
